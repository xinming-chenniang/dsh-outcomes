{
  "name": "dsh-outcomes",
  "version": "0.1.0",
  "description": "DSH 成果管理器：把最终成果（报告 / 网页 / 文档 / 表格 / 图片 / 数据表）登记成一份可检索、可预览、可回收的清单 —— agent 登记、人看图、脚本能查。 | DSH outcomes manager: register deliverables (reports, pages, docs, sheets, images, datasets) into one searchable, previewable, recoverable registry — agents register, humans browse, scripts query.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/284022719/dsh-outcomes.git"
  },
  "bugs": {
    "url": "https://github.com/284022719/dsh-outcomes/issues"
  },
  "homepage": "https://github.com/284022719/dsh-outcomes#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "outcomes",
    "deliverables",
    "artifacts",
    "registry",
    "cordis"
  ],
  "type": "module",
  "main": "lib/tools.js",
  "exports": {
    ".": "./lib/tools.js",
    "./client": "./lib/client.js",
    "./store": "./lib/store.js",
    "./page": "./lib/page.js",
    "./package.json": "./package.json",
    "./web": "./lib/index.js"
  },
  "bin": {
    "dsh-outcomes": "./bin/dsh-outcomes.mjs"
  },
  "files": [
    "lib",
    "bin",
    "docs",
    "tools",
    "assets/screenshots",
    "screenshots.json",
    "cordis.patch.yml",
    "config.example.json",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node --test test/",
    "check": "node tools/check.mjs",
    "guards": "node tools/guard-check.mjs",
    "pack:check": "npm pack --dry-run --json",
    "preflight": "npm test && npm run check && npm run pack:check"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    }
  }
}
